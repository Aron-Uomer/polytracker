// Prisma schema for Whole Record
// Postgres is the production target. See server/.env.example for DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cached, computed stats for a Polymarket trader keyed by their proxy wallet.
/// We refetch from Polymarket only when this row is older than CACHE_TTL_SECONDS.
model Trader {
  address      String  @id // lowercased proxy wallet address
  name         String?
  pseudonym    String?
  profileImage String?

  portfolioValue Float   @default(0)
  totalProfit    Float   @default(0) // canonical all-time profit (leaderboard API)
  profitToday    Float   @default(0)
  totalVolume    Float   @default(0)
  totalTrades    Int     @default(0)
  tradesCapped   Boolean @default(false)
  openPositions  Int     @default(0)
  resolvedCount  Int     @default(0)
  wins           Int     @default(0)
  losses         Int     @default(0)
  winRate        Float? // null when no resolved positions yet

  // Full computed payload (positions list etc.) so the frontend can render
  // everything from cache without recomputing.
  payload Json

  lastFetchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
}

/// One on-chain activity event (trade / redeem) for a wallet. Filled
/// incrementally by the indexer so stats can be computed exactly and instantly
/// from the database instead of re-fetching Polymarket on every lookup.
// The Trade table is gone. It cached every trade of every wallet anyone ever
// searched, forever: 196,243 rows across 8 wallets came to 226 MB, and it grew
// without bound. Stats are now always computed from a live, bounded read of
// Polymarket's activity feed. See the drop_trade_cache migration.

/// Point-in-time snapshot used for charting a trader's history over time.
// StatSnapshot is gone with the P&L history chart it backed. The activity
// calendar is unaffected — it reads dailySeries, which comes from the live
// trade walk rather than from stored snapshots.

/// --- SaaS layer (wired for later: auth + saved wallets) ---

model User {
  id           String   @id @default(cuid()) // may also be an anonymous client id
  email        String?  @unique
  name         String?
  passwordHash String? // null for anonymous (client-id) users
  plan         String   @default("free") // "free" | "pro"

  // Pro is granted for a period after each crypto payment (NOWPayments).
  proExpiresAt DateTime?

  createdAt DateTime @default(now())

  tracked TrackedWallet[]
}

/// One processed NOWPayments IPN. The payment id is the primary key, so a
/// replayed callback fails to insert and can't grant a second Pro period.
model Payment {
  id        String   @id // NOWPayments payment_id
  userId    String
  amountUsd Float
  status    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model TrackedWallet {
  id        String   @id @default(cuid())
  userId    String
  address   String
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
}
