# PostgreSQL connection string.
# Easiest free option: create a project at https://neon.tech and paste the
# connection string here. It works for both local dev and production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Port the API server listens on
PORT=4000

# How long (seconds) cached trader stats are considered fresh before refetching
CACHE_TTL_SECONDS=300

# Trade counting pages the /activity feed backward through time. These bound how
# far a single lookup will go so it stays responsive. Raise them to count more
# trades for very active wallets (at the cost of slower cold lookups). Each page
# is 500 trades. The real fix for mega-whales is a background indexer (see README).
TRADES_MAX_PAGES=40
TRADES_TIME_BUDGET_MS=25000

# Background indexer: max time (ms) a single indexing pass spends ingesting a
# wallet's trades into the database. Whales finish over several passes.
INDEX_BUDGET_MS=20000

# How many indexed Trade rows to read per batch when computing stats from the
# database. Lower = less memory per request, more round trips.
INDEX_READ_BATCH=5000

# Timeout (ms) for a single call out to Polymarket, so a stalled upstream
# connection can't hold a request (and a server worker) open forever.
FETCH_TIMEOUT_MS=15000

# History snapshots: the minimum gap between two snapshots of the same wallet,
# and how many to keep. Snapshots exist to chart a trend, not to log page views.
SNAPSHOT_MIN_INTERVAL_SECONDS=3600
SNAPSHOT_RETENTION=500

# Comma-separated list of origins allowed to call the API (the frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign auth (JWT) tokens. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Google sign-in (optional). Create an OAuth 2.0 "Web application" Client ID at
# https://console.cloud.google.com/apis/credentials with authorized JavaScript
# origin http://localhost:5173 (add your prod URL for deploy). Use the SAME id
# below in VITE_GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=""

# --- Crypto billing via NOWPayments (optional) ---
# Leave blank to keep the dev "Upgrade to Pro" stub, which only works locally
# (NODE_ENV != production). Fill these to enable real crypto checkout — see
# README "Billing". Sandbox: use api-sandbox.nowpayments.io.
APP_URL="http://localhost:5173"          # frontend URL (success/cancel redirects)
API_PUBLIC_URL=""                        # PUBLIC url of THIS server for IPN callbacks (e.g. an ngrok/https URL)
NOWPAYMENTS_API_KEY=""                   # from NOWPayments dashboard → Payments → API keys
NOWPAYMENTS_IPN_SECRET=""                # from NOWPayments dashboard → Payments → IPN settings
NOWPAYMENTS_API_URL="https://api.nowpayments.io/v1"  # or https://api-sandbox.nowpayments.io/v1 for testing

# --- Client (browser) variables ---
# Only VITE_-prefixed vars are bundled into the frontend; everything above stays
# server-side. Vite reads this same file (see client/vite.config.ts envDir).
VITE_API_BASE=""                  # leave blank in dev (Vite proxies /api). Set to the API URL in prod.
VITE_GOOGLE_CLIENT_ID=""          # SAME value as GOOGLE_CLIENT_ID above, to show the Google button
