# Frontend environment. Copy to .env.local for development; set the same keys
# in Vercel's project settings for production. Everything here ships to the
# browser — never put a secret in a VITE_ variable.

# Deployed API origin. Leave empty in dev: vite.config.ts proxies /api to
# localhost:4000 instead.
VITE_API_BASE=

# Google OAuth client id (optional). Sign-in with Google hides itself if unset.
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (optional).
# Unset means no tracking script is loaded and no cookie is set. Analytics is
# also disabled on the dev server even when this is present, so local clicking
# never pollutes the property.
VITE_GA_ID=
